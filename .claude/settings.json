      "Bash(git pull *)",
      "Bash(git remote *)",
      "Bash(git rev-parse *)",
      "Bash(git mv *)",
      "Bash(gh *)",
      "Bash(ls *)",
      "Bash(which *)",
      "Bash(wc *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(head *)",
      "Bash(tail *)"
